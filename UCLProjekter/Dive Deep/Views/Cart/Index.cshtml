@model CartViewModel

<div class="container">
    <div class="row">
        <!-- Venstre: kurv -->
        <div class="col-md-6">
            <h3>Din kurv</h3>
            @if (Model.Items.Any())
            {
                <ul class="list-group d-flex justify-content-between">
                    @foreach (var item in Model.Items)
                    {
                        <li class="list-group-item">
                            <div class="row">
                                <div class="col-9">
                                    <strong>@item.Brand</strong> (@item.ProductType) <br />
                                    @item.Details <br />
                                    <span>@item.PricePerDay kr/dag</span>
                                </div>
                                <div class="col-3 text-end">
                                    <a class="btn btn-outline-danger" asp-controller="Cart" asp-action="Remove" asp-route-itemId="@item.CartItemId">Fjern</a>
                                </div>
                            </div>
                        </li>

                    }
                    
                </ul>
                <p class="mt-3"><strong>Total pr. dag:</strong> @Model.TotalPricePerDay kr</p>
            }
            else
            {
                <p>Din kurv er tom.</p>
            }
        </div>

        <!-- Højre: booking form -->
        <div class="col-md-6">
            <h3>Opret booking</h3>
            <form asp-controller="Bookings" asp-action="Add" method="post">
                <div class="mb-3">
                    <label asp-for="StartTime" class="form-label">Starttidspunkt</label>
                    <input asp-for="StartTime" type="datetime-local" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="EndTime" class="form-label">Sluttidspunkt</label>
                    <input asp-for="EndTime" type="datetime-local" class="form-control" />
                </div>

                <button type="submit" class="btn btn-primary">Book nu</button>
            </form>
        </div>
    </div>
</div>