@model Dive_Deep.ViewModels.ProductDetailsViewModel


<!-- Bootstrap 5 (hvis ikke allerede loaded i _Layout) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<!-- Font Awesome -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />

<div class="container py-5">
    <div class="row">
        <!-- Product Images -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <img src="https://shop11921.sfstatic.io/upload_dir/shop/_thumbs/fourth-element-proteus-2-herre-a.w610.h610.fill.jpg"
                     class="card-img-top" alt="@Model.Representative.Brand">
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-3">
                            <img src="https://shop11921.sfstatic.io/upload_dir/shop/_thumbs/fourth-element-proteus-2-herre-b.w610.h610.fill.jpg"
                                 class="img-thumbnail" alt="Thumb 1">
                        </div>
                        <div class="col-3">
                            <img src="https://shop11921.sfstatic.io/upload_dir/shop/_thumbs/fourth-element-proteus-2-dame-a-1.w610.h610.fill.jpg"
                                 class="img-thumbnail" alt="Thumb 2">
                        </div>
                        <div class="col-3">
                            <img src="https://shop11921.sfstatic.io/upload_dir/shop/_thumbs/fourth-element-proteus-2-dame-b-1.w610.h610.fill.jpg"
                                 class="img-thumbnail" alt="Thumb 3">
                        </div>
                        <div class="col-3">
                            <img src="http://kingfish.dk/media/catalog/product/cache/fd29bf4339f690415ec423d352947884/f/o/fourth-element-proteus-10.jpg"
                                 class="img-thumbnail" alt="Thumb 4">
                        </div>
                    </div>
                </div>
            </div>
        </div>



        <!-- Product Details -->
        <div class="col-md-6">
            <h1 class="h2 mb-3">@Model.Representative.Brand</h1>

            <div class="mb-3">
                <span class="h6">@Model.Representative.PricePerDay,- kr. pr. dag</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.RepresentativeSecondaryLabel))
            {
                <div class="mb-2">
                    <strong>@Model.RepresentativeSecondaryLabel:</strong> @Model.RepresentativeSecondaryValue
                </div>
            }


            <!--HERFRA-->
            <form method="post" asp-controller="Cart" asp-action="Add" class="mt-4">
                @Html.AntiForgeryToken()

                <!-- Bruges kun til redirect/fejl hvis lookup fejler -->
                <input type="hidden" name="representativeId" value="@Model.Representative.ProductId" />
                <input type="hidden" name="brand" value="@Model.Representative.Brand" />
                <input type="hidden" name="model" value="@Model.RepresentativeSecondaryValue" />

                @if (Model.Representative is BCD)
                {
                    <div class="mb-3">
                        <label>Størrelse</label>
                        <select name="selectedProductId" class="form-select"
                                asp-items="@(new SelectList(Model.Variants.OfType<BCD>(), "ProductId", "Sizes"))">
                            <option value="">-- Vælg --</option>
                        </select>
                    </div>
                }
                else if (Model.Representative is DivingSuit)
                {
                    <div class="mb-3">
                        <label>Størrelse</label>
                        <select name="selectedSize" class="form-select">
                            <option value="">-- Vælg --</option>
                            @foreach (var s in Model.Sizes)
                            {
                                <option value="@s">@s</option>
                            }
                        </select>

                        <label class="mt-2">Køn</label>
                        <select name="selectedGender" class="form-select">
                            <option value="">-- Vælg --</option>
                            @foreach (var g in Model.Genders)
                            {
                                <option value="@g">@g</option>
                            }
                        </select>

                        <label class="mt-2">Tykkelse (mm)</label>
                        <select name="selectedThickness" class="form-select">
                            <option value="">(Valgfri)</option>
                            @foreach (var t in Model.Thicknesses)
                            {
                                <option value="@(t?.ToString() ?? "")">@t</option>
                            }
                        </select>
                    </div>
                }
                else if (Model.Representative is Finns)
                {
                    <div class="mb-3">
                        <label>Størrelse</label>
                        <select name="selectedProductId" class="form-select"
                                asp-items="@(new SelectList(Model.Variants.OfType<Finns>(), "ProductId", "Sizes"))">
                            <option value="">-- Vælg --</option>
                        </select>
                    </div>
                }
                <!-- Andre product-typer: tilsvarende patterns -->

                <button type="submit" class="btn btn-primary">Tilføj til kurv</button>

                @* Vis TempData beskeder *@
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger mt-3">@TempData["Error"]</div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success mt-3">@TempData["Success"]</div>
                }
            </form>

            <!--HERTIL-->
            <!-- Quantity -->
            @*<div class="mb-4">
                <div class="d-flex align-items-center">
                    <label class="me-2">Antal:</label>
                    <select class="form-select w-auto">
                        <option>1</option>
                        <option>2</option>
                        <option>3</option>
                    </select>
                </div>
            </div>*@

            <!-- Actions -->

            

            <!-- Extra info -->
            @*<div class="mt-4">
                <div class="d-flex align-items-center mb-2">
                    <i class="fas fa-truck text-primary me-2"></i>
                    <span>Gratis levering ved køb over 500 kr</span>
                </div>
                <div class="d-flex align-items-center mb-2">
                    <i class="fas fa-undo text-primary me-2"></i>
                    <span>30 dages returret</span>
                </div>
                <div class="d-flex align-items-center">
                    <i class="fas fa-shield-alt text-primary me-2"></i>
                    <span>2 års garanti</span>
                </div>*@
        </div>
    </div>
</div>
